# AI Station — server-side environment (VPS only).
# Created ONCE on the server at ~/aistation/deploy/.env
# deploy.sh ships the compose + nginx files but NOT this file (it is gitignored).
# All values are OPTIONAL — leave blank to run free (edge-tts/ffmpeg/Pillow).

WEBHOOK_SECRET=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
NCBDB_BASE_URL=
NCBDB_TOKEN=
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
AI_STATION_LOG_LEVEL=INFO
