# ============================================================
# AI Station — environment configuration
# ------------------------------------------------------------
# Copy this file to `.env` and fill values you want to use.
# EVERYTHING is optional: with no keys set, the station runs
# fully on FREE local tooling (edge-tts + ffmpeg + Pillow),
# exactly as the IDEA.md "no GPU needed" architecture prescribes.
# ============================================================

# ---- 2. Text parsing (LLM Brain) ----
# Off by default -> a built-in free parser turns a script into
# shots automatically. Set OPENAI_API_KEY to enable GPT-4o parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 3. Speech engine (TTS) ----
# Off by default -> uses Microsoft edge-tts (free, no key).
# Set ELEVENLABS_API_KEY to enable ElevenLabs voice cloning.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- 4. Visuals ----
# Off by default -> generates gradient/ken-burns backgrounds with Pillow.
# Set RUNWAY_API_KEY to enable AI video B-roll.
RUNWAY_API_KEY=

# ---- 6. Cloud storage ----
# Off by default -> stores assets on local ./storage.
# Set the below to push final MP4 to S3 / GCS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ---- 7. Provenance log (Database) ----
# Off by default -> uses local SQLite (jobs.db).
# Set NCBDB_BASE_URL + NCBDB_TOKEN to log to NoCodeBackend.
NCBDB_BASE_URL=
NCBDB_TOKEN=

# ---- Rendering ----
# Keep these defaults unless you change resolution/FPS.
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30

# ---- Server ----
HOST=0.0.0.0
PORT=8000
