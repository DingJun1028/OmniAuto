# AI Station — environment configuration (copy to .env; never commit .env)
# All cloud integrations are OPTIONAL. Leave blank to run on free local tooling.

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Webhook security (optional) ----
# When set, inbound POST /webhook/n8n must carry this value via the
# `X-AI-Station-Key` header or `?key=` query param. Leave blank = open.
WEBHOOK_SECRET=

# ---- 2. Text parsing (LLM brain) ----
# Set to enable GPT-4o shot planning instead of the built-in free parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 3. TTS ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- 4. Visuals ----
RUNWAY_API_KEY=

# ---- 6. Cloud storage ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ---- 7. Provenance DB ----
NCBDB_BASE_URL=
NCBDB_TOKEN=

# ---- Rendering ----
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30

# ---- Shared CJK font (optional override) ----
# Auto-resolved cross-platform; set only to force a specific font file.
FONT_PATH=
